# Environment configuration for AI Output Quality Evaluation Dashboard
# Copy this file to .env and configure your keys. Never commit .env.

# Active AI judge provider: freellmapi | gemini | anthropic
AI_PROVIDER=freellmapi

# FreeLLMAPI / Local OpenAI-compatible gateway
FREELLMAPI_API_KEY=freellmapi-key
FREELLMAPI_BASE_URL=http://localhost:3001/v1
# FREELLMAPI_MODEL=auto

# Google Gemini API key
# GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-3.8-flash

# Anthropic Claude API key
# ANTHROPIC_API_KEY=your-anthropic-key-here
# EVAL_MODEL=claude-sonnet-5-5
